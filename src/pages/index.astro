---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Philip Policki">
	<div class="flex flex-col w-full items-center">
		<main class="w-4/12 flex flex-col gap-8">
			<h1 class="text-background-200 text-3xl mt-4">
				My name is
				<span class="text-4xl mx-3 ">
					<span class="bg-gradient-to-t from-accent-400 to-accent-600 text-transparent bg-clip-text">
						Philip Policki,
					</span>
				</span>
				hello there !
			</h1>

			<p class="text-background-200">
			</p>
		</main>
	</div>

</Layout>
