---
import type { Blog } from "../types/blog";
import Navbar from "../components/Navbar.astro";
import Prose from "../components/Prose.astro";
interface Props {
    frontmatter: Blog
}

const { frontmatter } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="description" content="Personal website of Philip Policki a software developer" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{frontmatter.title}</title>
</head>
<body class="bg-background-900 text-background-200">
    <Navbar />
    <main class="flex w-full flex-col items-center mt-12">
        <Prose>
            <h1 class="mb-4">{frontmatter.title}</h1>
            <slot />
        </Prose>
    </main>

    <footer class="mt-40"></footer>
</body>
</html>
